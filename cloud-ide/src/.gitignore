# Ignore Node modules in all subdirectories
node_modules/

# Ignore environment variables
.env

# Ignore Vite build caches
dist/
.vite/
opensandbox/sandbox-env/
opensandbox/__pycache__/
opensandbox/.sandbox.resolved.toml

# Dev-only HMAC key for the `uid` identity cookie. Generated on first boot when
# AUTH_SECRET is unset; production must supply AUTH_SECRET instead. Never commit.
**/.auth-secret
*.pyc

.env.local

# OpenSandbox Local Data
sandbox-data/
.sandbox-data/

../../__tests__/