PORT=3000
OPENSANDBOX_API_URL=http://127.0.0.1:8080
OPENSANDBOX_API_KEY=
OPENSANDBOX_EXECD_ACCESS_TOKEN=
# Sandbox driver: 'opensandbox' (default, Rust kernel, exec-only) or 'alibaba'
# (adds an interactive PTY; requires `npm i @alibaba-group/opensandbox` + validation)
SANDBOX_DRIVER=opensandbox
PUBLIC_API_URL=http://localhost:3000
RUST_CONNECT_TIMEOUT=10
RUST_READ_TIMEOUT=120
GATEWAY_TIMEOUT=130000
SWEEP_INTERVAL_MS=3600000 
# THIS IS FOR THE TYPE OF MEMORY STORAGE FOR BUILDS 'json' (default) | 'memory' | 'redis'
BUILD_STORE=
# Registry host to qualify + push built images to, e.g. reg.example.com:5000.
# Unset => local-only (tags stay bare, no push). Auth is ops-provisioned (docker login).
DOCKER_REGISTRY=

# Where ALL server state lives: JSON repos, git central-repo + worktrees, sessions,
# the dev auth secret. Unset => backend/data (historical default). Put it on FAST LOCAL
# storage for much quicker boots — this is the biggest boot-speed lever. On WSL the default
# lives on the slow /mnt 9p bridge, so point it at native ext4, e.g. CIDE_DATA_DIR=/root/cide-data.
# On any Linux server, a local volume works the same. The daemon (opensandbox/boot.js) reads
# this too, so keep gateway + daemon on one .env. Relocating starts fresh (or move the dir).
CIDE_DATA_DIR=

